# ============================================================================
#  .htaccess — raíz de insusermx.com
#
#  Hostinger publica este repositorio TAL CUAL como public_html: lo que esté
#  aquí se sirve por web. Este archivo saca del aire lo que es material de
#  desarrollo y no parte del sitio.
#
#  Comprobado el 12/08/2026: sin estas reglas se descargaban en abierto el
#  documento Word original del cliente (1.4 MB), la especificación técnica y
#  los archivos de compilación.
# ============================================================================

# --- La portada es PHP ------------------------------------------------------
DirectoryIndex index.php index.html

# --- Nada de archivos ocultos ni de contraseñas ----------------------------
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Material de desarrollo, no del sitio ----------------------------------
<FilesMatch "\.(md|docx|doc|mjs|json|log|bak|zip)$">
  Require all denied
</FilesMatch>

# --- Carpetas que no deben servirse ----------------------------------------
RedirectMatch 404 ^/hosting(/.*)?$
RedirectMatch 404 ^/cron(/.*)?$
RedirectMatch 404 ^/docs(/.*)?$

# La aplicacion servida por boletin.php y su codigo fuente NO se sirven
# directamente: si se pudieran pedir por URL, la pantalla de acceso no
# serviria de nada.
RedirectMatch 404 ^/privado(/.*)?$
RedirectMatch 404 ^/boletin(/.*)?$

# --- Sin listados de directorio --------------------------------------------
Options -Indexes

# --- Acentos correctos ------------------------------------------------------
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js

# --- Que el navegador no sirva versiones viejas tras cada despliegue --------
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================================================
#  CONTRASEÑA DE ACCESO
#
#  OJO: hPanel escribe estas líneas en el .htaccess DEL SERVIDOR, y como el
#  despliegue sobrescribe este archivo con el del repositorio, la contraseña
#  desaparecería en el siguiente despliegue sin avisar. Por eso tienen que
#  vivir aquí, en el repositorio.
#
#  PASOS
#  1. hPanel → Avanzado → Proteger directorios con contraseña.
#     Elige public_html, pon usuario y contraseña, y guarda.
#     Eso crea el archivo .htpasswd (fuera de public_html) con el hash.
#  2. Abre public_html/.htaccess en el Administrador de archivos y copia la
#     ruta exacta que hPanel puso en AuthUserFile.
#  3. Descomenta las cuatro líneas de abajo, pega esa ruta, y sube el cambio
#     al repositorio. Así la contraseña sobrevive a los despliegues.
#
#  El .htpasswd NUNCA va en el repositorio: contiene el hash de la contraseña
#  y quedaría publicado en GitHub.
# ============================================================================

# AuthType Basic
# AuthName "Herramientas del despacho"
# AuthUserFile "/home/uXXXXXXXX/.htpasswds/public_html/passwd"
# Require valid-user
